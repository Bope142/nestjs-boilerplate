APP_NAME=NestJS Boilerplate
PORT=3000
NODE_ENV=development

# PostgreSQL — pick DEV locally; PROD is only used when NODE_ENV=production
DATABASE_URL_DEV=postgresql://postgres:postgres@localhost:5432/app_dev
DATABASE_URL_PROD=postgresql://postgres:postgres@localhost:5432/app_prod

# Authentication and token security
JWT_SECRET=change-me-to-a-random-secret-with-at-least-32-chars
REFRESH_JWT_SECRET=change-me-to-another-random-secret-32-chars-min
TOKEN_ENCRYPTION_KEY=change-me-to-a-random-encryption-key-32-chars-min
JWT_EXPIRES_IN=15m
REFRESH_JWT_EXPIRES_IN=7d
SESSION_CLEANUP_DAYS=30
FRONTEND_BASE_URL=http://localhost:5173

# Email delivery
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_DELAY=1000
EMAIL_TIMEOUT=10000
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=mailer@example.com
MAIL_PASSWORD=change-me
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=App

# Redis / cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=app:
REDIS_TTL=3600
CACHE_ENABLED=true

# BullMQ / jobs (queue Redis DB should differ from cache DB)
JOBS_ENABLED=true
REDIS_QUEUE_DB=1
REMINDER_MAX_ACTIVE_PER_USER=25
REMINDER_MAX_SLOTS=5
REMINDER_MAX_CHANNELS=2
REMINDER_SCHEDULER_INTERVAL_MS=60000
REMINDER_SCHEDULER_BATCH_SIZE=100
REMINDER_DISPATCH_CONCURRENCY=5
NOTIFICATION_EMAIL_CONCURRENCY=3
NOTIFICATION_IN_APP_CONCURRENCY=10
NOTIFICATION_EMAIL_MAX_PER_SECOND=10
JOB_ATTEMPTS=5
JOB_BACKOFF_MS=30000

# Rate limiting (global; override per-route with @Throttle)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ENABLED=true
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# Internal and external integrations
API_ACCESS_KEY=change-me-api-access-key
WORLD_TIME_API_BASE_URL=https://worldtimeapi.org/api
GOOGLE_CLIENT_ID=change-me-google-client-id

# Initial platform administrator (used by pnpm db:seed)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-strong-password
SUPER_ADMIN_FIRST_NAME=Platform
SUPER_ADMIN_LAST_NAME=Admin
