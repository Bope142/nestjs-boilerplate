{
  "name": "nestjs-boilerplate",
  "version": "0.2.0",
  "description": "Production-ready NestJS boilerplate with auth, Drizzle, Redis, and email",
  "author": "Norbert Yemuang",
  "private": true,
  "packageManager": "pnpm@10.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0",
    "pnpm": ">=10.1.0"
  },
  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||''; if(!ua.includes('pnpm')){console.error('Use pnpm install (not npm/yarn).'); process.exit(1)}\"",
    "prepare": "node ./scripts/install-git-hooks.mjs",
    "hooks:install": "node ./scripts/install-git-hooks.mjs",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"tools/**/*.ts\" \"scripts/**/*.{ts,mjs,js}\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "setup": "node ./scripts/setup.mjs",
    "init:project": "node ./scripts/init-project.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint \"{src,apps,libs,test,scripts,tools}/**/*.ts\" --fix",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.config.cjs",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.config.cjs --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.config.cjs --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk ./node_modules/jest/bin/jest.js --config ./jest.config.cjs --runInBand",
    "test:e2e": "node ./scripts/run-with-node-env.mjs test node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.config.cjs --runInBand",
    "audit": "pnpm audit",
    "audit:security": "pnpm audit --prod",
    "db:generate": "drizzle-kit generate && pnpm db:diagram:generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "node ./scripts/run-with-node-env.mjs test drizzle-kit migrate",
    "db:setup:test": "node ./scripts/db-setup-test.mjs",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:seed": "ts-node -r tsconfig-paths/register scripts/seed-users.ts",
    "db:diagram:generate": "ts-node -r tsconfig-paths/register tools/database-diagram/cli.ts generate",
    "db:diagram:check": "ts-node -r tsconfig-paths/register tools/database-diagram/cli.ts check",
    "db:diagram:validate": "ts-node -r tsconfig-paths/register tools/database-diagram/cli.ts validate",
    "docker:dev": "docker compose up -d"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.1",
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/passport": "^12.0.1",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "argon2": "^0.45.2",
    "bullmq": "^5.71.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "ejs": "^3.1.10",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.9.3",
    "luxon": "^3.7.2",
    "nestjs-i18n": "^10.8.5",
    "nodemailer": "^10.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.0",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.15.18",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.19.15",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^7.2.0",
    "@xmldom/xmldom": "^0.9.8",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.57.0"
  },
  "pnpm": {
    "overrides": {
      "handlebars": ">=4.7.10",
      "proxy-addr": ">=2.0.8",
      "brace-expansion@<1.1.17": "1.1.17",
      "piscina": ">=4.9.4",
      "@xhmikosr/decompress": ">=10.2.2"
    }
  },
  "lint-staged": {
    "{src,apps,libs,test,scripts,tools}/**/*.ts": [
      "eslint --fix"
    ]
  }
}
